# MCP AI Agent Lab environment template
#
# Copy this file to $HOME/lab.env and replace placeholder values:
#   cp .env.example "$HOME/lab.env"
#
# Never commit $HOME/lab.env or paste its values into tickets, chat, or logs.

# Listener ports, TLS paths, and startup behavior are defined by the root
# Makefile. The integrated LibreChat workflow requires MCP TLS on its default
# ports; custom transport settings are for MCP-only development targets.

# Required shared key for both MCP streamable HTTP endpoints.
# Generate a unique value, for example: openssl rand -hex 32
MCP_API_KEY=replace-with-a-unique-long-random-value

# Cisco Catalyst Center credentials
CC_USER=replace-with-catalyst-username
CC_PASS=replace-with-catalyst-password

# Meraki Magic MCP credentials and safety settings
MERAKI_API_KEY=replace-with-meraki-magic-api-key
MERAKI_ORG_ID=replace-with-meraki-organization-id
MERAKI_BASE_URL=https://api.meraki.com/api/v1
MERAKI_PYTHON_SDK_CALLER=MagicMCP CiscoDevNet
READ_ONLY_MODE=true
MERAKI_MCP_TRANSPORT=http

# Optional Meraki Magic response tuning
ENABLE_CACHING=true
CACHE_TTL_SECONDS=300
ENABLE_FILE_CACHING=true
MAX_RESPONSE_TOKENS=5000
MAX_PER_PAGE=100
RESPONSE_CACHE_DIR=.meraki_cache

# Optional bundled Meraki MCP on port 8001
MERAKI_LAB_API_KEY=replace-with-meraki-lab-api-key
MERAKI_PROD_API_KEY=

# Remote Splunk MCP bearer token
SPLUNK_MCP_BEARER=replace-with-splunk-mcp-bearer-token
SPLUNK_MCP_EP=https://replace-with-splunk-mcp-host/en-US/splunkd/__raw/services/mcp

# Remote ThousandEyes MCP API credential
THOUSANDEYES_API_KEY=replace-with-thousandeyes-api-key

# LibreChat local app. The integrated launcher owns ports 3080/3081 and binds
# the backend to 127.0.0.1.
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true

# Generate these values with:
#   bash ai-agent-librechat-oss/scripts/gen_secrets.sh
CREDS_KEY=replace_with_64_hex_chars
CREDS_IV=replace_with_32_hex_chars
JWT_SECRET=replace_with_64_hex_chars
JWT_REFRESH_SECRET=replace_with_64_hex_chars
MEILI_MASTER_KEY=replace_with_32_plus_chars

# AWS Bedrock. Leave static credentials empty when using the standard AWS
# credential chain, such as ~/.aws/credentials or an assigned IAM role.
BEDROCK_AWS_DEFAULT_REGION=us-west-2
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
BEDROCK_AWS_SESSION_TOKEN=
# Accepts the system inference-profile ARN or its profile ID.
BEDROCK_AWS_MODELS=global.anthropic.claude-sonnet-4-6
# Required system inference-profile ARN for the global Claude Sonnet model.
# Keep the real ARN only in $HOME/lab.env.
BEDROCK_INFERENCE_PROFILE_CLAUDE_SONNET=

# Cloud LiteLLM endpoint used for SharonAI Gemma and Claude Haiku.
LITELLM_API_KEY=replace-with-litellm-api-key

# Optional override. The launcher defaults to the shared certificate at
# <lab-root>/certs/mcp-selfsigned.crt.
NODE_EXTRA_CA_CERTS=

# Optional logging overrides
MCP_LOG_DIR=logs
MCP_LOG_LEVEL=INFO
MCP_LOG_MODE=a
CATALYST_LOG_FILE=catalyst_center_mcp.log
MERAKI_LOG_FILE=meraki_mcp.log
