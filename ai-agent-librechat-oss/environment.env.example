# Reference template only. The integrated lab stores these values in
# $HOME/lab.env; do not create or commit environment.env in this directory.

# Web app/server. The integrated launcher owns ports 3080/3081 and binds the
# backend to 127.0.0.1.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true

# Local MongoDB (required)
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat

# LibreChat required encryption keys (generate via scripts/gen_secrets.sh)
CREDS_KEY=replace_with_64_hex_chars
CREDS_IV=replace_with_32_hex_chars
JWT_SECRET=replace_with_64_hex_chars
JWT_REFRESH_SECRET=replace_with_64_hex_chars
MEILI_MASTER_KEY=replace_with_32_plus_chars

# AWS Bedrock
BEDROCK_AWS_DEFAULT_REGION=us-west-2
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
BEDROCK_AWS_SESSION_TOKEN=

# List profile ARNs or profile IDs to expose in LibreChat
BEDROCK_AWS_MODELS=global.anthropic.claude-sonnet-4-6

# Required system inference-profile ARN for the global Claude Sonnet mapping
BEDROCK_INFERENCE_PROFILE_CLAUDE_SONNET=

# Cloud LiteLLM endpoint
LITELLM_API_KEY=replace-with-litellm-api-key

# MCP remote API key (sent as X-API-Key header from librechat.yaml)
MCP_API_KEY=replace-with-mcp-server-api-key

# Remote Splunk MCP bearer token
SPLUNK_MCP_BEARER=replace-with-splunk-mcp-bearer-token
SPLUNK_MCP_EP=https://replace-with-splunk-mcp-host/en-US/splunkd/__raw/services/mcp

# Remote ThousandEyes MCP API credential
THOUSANDEYES_API_KEY=replace-with-thousandeyes-api-key

# Trust the shared lab certificate when connecting to local HTTPS MCP servers.
# Use the absolute path to <lab-root>/certs/mcp-selfsigned.crt.
NODE_EXTRA_CA_CERTS=replace-with-absolute-lab-certificate-path
